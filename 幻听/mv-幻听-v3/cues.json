[
 {
  "t0": 0.7,
  "t1": 4.6,
  "text": "如今一个人听歌\n总是会觉得失落"
 },
 {
  "t0": 5.36,
  "t1": 8.35,
  "text": "幻听你在我的耳边\n轻轻诉说"
 },
 {
  "t0": 8.92,
  "t1": 10.72,
  "text": "夜色多温柔"
 },
 {
  "t0": 11.12,
  "t1": 12.92,
  "text": "你有多爱我"
 },
 {
  "t0": 15.68,
  "t1": 19.58,
  "text": "如今一个人听歌\n总是会觉得难过"
 },
 {
  "t0": 20.34,
  "t1": 23.45,
  "text": "爱已不在这里\n我却还没走脱"
 },
 {
  "t0": 23.92,
  "t1": 26.85,
  "text": "列表里的歌\n随过往流动"
 }
