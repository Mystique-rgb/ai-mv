{
"t0": 22.3,
"t1": 26.27,
"text": "会在何处见到你"
},
{
"t0": 27.82,
"t1": 31.79,
"text": "莫非前尘已注定"
},
{
"t0": 31.9,
"t1": 36.97,
"text": "飞过时空的距离"
},
{
"t0": 37.12,
"t1": 42.04,
"text": "却囿于刀剑光影"
},
{
"t0": 42.1,
"t1": 46.14,
"text": "三月春花渐次醒"
},
{
"t0": 46.74,
"t1": 51.79,
"text": "迢迢年华谁老去"
},
{
"t0": 51.94,
"t1": 56.99,
"text": "是劫是缘随我心"
},
{
"t0": 57.05,
"t1": 60.81,
"text": "除了你万敌不侵"
},
{
"t0": 61.9,
"t1": 64.84,
"text": "当恩怨各一半"
},
{
"t0": 64.9,
"t1": 67.38,
"text": "我怎么圈揽"
},
{
"t0": 67.44,
"t1": 69.78,
"text": "看灯笼血红染"
},
{
"t0": 69.84,
"t1": 72.26,
"text": "寻仇已太晚"
},
{
"t0": 72.32,
"t1": 76.1,
"text": "月下门童喟叹"
},
{
"t0": 76.16,
"t1": 81.67,
"text": "昨夜太平长安"
},
{
"t0": 82.1,
"t1": 84.4,
"text": "当天上星河转"
},
{
"t0": 84.46,
"t1": 87.42,
"text": "我命已定盘"
},
{
"t0": 87.48,
"t1": 89.48,
"text": "待绝笔墨痕干"
},
{
"t0": 89.54,
"t1": 91.94,
"text": "宿敌已来犯"
},
{
"t0": 92.0,
"t1": 95.37,
"text": "我借你的孤单"
},
{
"t0": 96.05,
"t1": 101.81,
"text": "今生恐怕难还"
},
{
"t0": 123.5,
"t1": 128.64,
"text": "缠绕孤岛的雪雨"
},
{
"t0": 128.7,
"t1": 133.34,
"text": "飘飘洒洒谁来停"
},
{
"t0": 133.4,
"t1": 138.14,
"text": "摘取一颗海上星"
},
{
"t0": 138.2,
"t1": 142.4,
"text": "陪我终夜不孤寂"
},
{
"t0": 143.2,
"t1": 147.66,
"text": "灵柩长埋深谷底"
},
{
"t0": 148.5,
"t1": 152.48,
"text": "没有永远的秘密"
},
{
"t0": 153.2,
"t1": 157.32,
"text": "染指江湖结悲局"
},
{
