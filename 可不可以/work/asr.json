 },
 {
  "start": 81.8,
  "end": 85.4,
  "text": "只是更好情都初开遇到你"
 },
 {
  "start": 85.4,
  "end": 89.0,
  "text": "抱歉抱我的未來不是你"
 },
 {
  "start": 89.0,
