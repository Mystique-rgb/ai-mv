[
 {
  "start": 0.0,
  "end": 27.0,
  "text": "说好带你流浪 而我却半路返航 坠落自责的海洋。"
 },
 {
  "start": 30.0,
  "end": 34.0,
  "text": "发现离不开你"
 },
 {
  "start": 34.0,
